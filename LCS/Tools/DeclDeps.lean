import LCS.Item

/-! # DeclDeps: Find all LCS declarations a theorem statement depends on.

**Developer utility, not part of the automated pipeline.** Interactive tool for
inspecting the transitive LCS-prefixed dependency closure of a declaration, and
for auditing which dependencies are missing a checklist tag. Reach for it when
you are deciding what to tag, debugging why a benchmark closure pulls in an
unexpected symbol, or sanity-checking tag coverage across a module.

Tag lookups go through `LCS.lcsItemId?` / `LCS.isLcsMain` (defined in
`LCS/Item.lean`). Those names are kept for compatibility, but under the hood
they now read the LeanArchitect `@[blueprint "id" (main := true)]` attribute
rather than the retired `@[lcsitem]`/`@[lcsmain]` attributes.

Reads: the requested module(s) via `importModules` at runtime (CLI mode) or the
ambient elaboration environment (VS Code mode). Writes: nothing — prints to
stdout (CLI) or the Infoview (VS Code).

Two modes:
1. **VS Code**: Use `#eval stmtDeps `Name` — output in Lean Infoview. Because
   this file does not import the umbrella `LCS` module (see below), you must
   temporarily add an `import LCS.Foo.Bar` line at the top of this file so that
   the target declaration's symbols are resolvable. Do not commit that import
   edit.
2. **CLI**: `cd iter13 && lake env lean --run LCS/Tools/DeclDeps.lean [--module M]* LCS.Foo.bar`

## Partial-build support

This source file deliberately avoids `import LCS`. The umbrella module pulls in
every submodule under `LCS/`, so if any one of them fails to compile the tool
itself would fail to load. Instead, only `LCS.Item` (for the `@[lcsitem]`
attribute lookup) is imported at compile time; target modules are loaded at
runtime via `importModules`.

The CLI accepts one or more `--module M` flags. Each `M` is imported in place
of the umbrella. If no `--module` flag is given, a single module is auto-derived
from the declaration's namespace by dropping the last path component, so
`LCS.Foo.Bar.baz` imports `LCS.Foo.Bar`. Only the transitive dependencies of
the target statement need to be loadable; broken modules elsewhere under `LCS/`
are irrelevant as long as the requested modules build.
-/

open Lean in
/-- Collect every `LCS.`-prefixed constant name that appears anywhere in
expression `e` (recursing through applications, binders, `let`s, metadata and
projections). Non-LCS constants are ignored. Pure; returns the accumulated
`NameSet`. -/
partial def collectLCSConsts (e : Expr) : NameSet :=
  go e {}
where
  go (e : Expr) (acc : NameSet) : NameSet :=
    match e with
    | .const n _ => if n.toString.startsWith "LCS." then acc.insert n else acc
    | .app f a => go a (go f acc)
    | .lam _ t b _ => go b (go t acc)
    | .forallE _ t b _ => go b (go t acc)
    | .letE _ t v b _ => go b (go v (go t acc))
    | .mdata _ e => go e acc
    | .proj _ _ e => go e acc
    | _ => acc

/-- Decide whether a declaration's body (value) should be walked in
addition to its signature type. Mirrors `tag_verify.py` semantics:
  * `def` / `noncomputable def` / `abbrev` / `instance` → walk body
  * `theorem` / `lemma` → signature only
  * `axiom` / `opaque` / `quot` / `rec` → signature only
  * `inductive` / `structure` → handled by enumerating ctors

Rationale: a theorem's *proof* term is an implementation detail, so for
dependency purposes only its statement (type) matters; a `def`'s body is part
of what it means, so the body is walked too. -/
def shouldWalkBody (info : Lean.ConstantInfo) : Bool :=
  match info with
  | .defnInfo _   => true
  | .thmInfo _    => false
  | .quotInfo _   => false
  | .axiomInfo _  => false
  | .opaqueInfo _ => false
  | .ctorInfo _   => false
  | .recInfo _    => false
  | .inductInfo _ => false

/-- For an inductive type `n`, return its constructor names so their argument
types can be walked (constructors participate in downstream signatures whenever
the inductive's values appear). Returns `[]` for any non-inductive `n`. -/
def inductiveExtras (env : Lean.Environment) (n : Lean.Name) : List Lean.Name :=
  match env.find? n with
  | some (.inductInfo iv) => iv.ctors
  | _ => []

/-- For an auto-derived class instance name `n`, recover the type name it was
derived for.

Instances generated by `deriving Foo, Bar for T` follow the fixed pattern
`inst<Class><T>` (e.g. `instDecidableEqLiteral`, `instReprLiteral`). They live
in the SAME namespace as `T`, not under `T.*`, so the namespace-walk path in
`effectiveTag` cannot find their parent. This detects the `inst<Class>` prefix
for each known deriving class and returns `<NS>.<T>` so the caller can inherit
`T`'s tag. Returns `none` if `n` does not match the pattern. -/
def autoDerivedParent? (n : Lean.Name) : Option Lean.Name :=
  match n with
  | .str p s =>
    -- Try each known deriving prefix. The Lean compiler synthesises class
    -- instances with name `inst<ClassNameSansNamespaceColon>` followed by
    -- the suffix-free type name.
    let classes := ["DecidableEq", "Repr", "Inhabited", "ToString", "BEq",
                    "Hashable", "LT", "LE", "Ord", "Nonempty", "Subsingleton",
                    "Fintype", "Coe"]
    let rec tryClasses : List String → Option Lean.Name
      | [] => none
      | c :: rest =>
        let pre := "inst" ++ c
        if s.startsWith pre && s.length > pre.length then
          let typeSuffix := s.toSubstring.drop pre.length |>.toString
          some (.str p typeSuffix)
        else tryClasses rest
    tryClasses classes
  | _ => none

/-- Find the EFFECTIVE tag of a name `n`, following source-level ownership.

If `n` itself carries a checklist tag, return it. Otherwise, if `n` is an
auto-generated field/constructor/recursor/instance of some parent declaration
(structure, inductive, `deriving` clause), look up the PARENT declaration's tag.
This mirrors what `tag_verify.py` sees: the source file has one block for
`inductive Foo ... | bar | baz`, one tag on that block, and the constructors
`Foo.bar`/`Foo.baz` are produced implicitly — they are "tagged" iff `Foo` is
tagged.

Resolution order: own tag → ctor/recursor's inductive → structure-projection
parent → auto-derived instance's type → namespace-chain ancestor (recursing
until a tagged ancestor or the anonymous root). Returns the tag string
(e.g. `"chap5__definition_5_2_1"`) or `none`. -/
partial def effectiveTag (env : Lean.Environment) (n : Lean.Name) : Option String :=
  -- First: does the name itself carry a source-level tag?
  match LCS.lcsItemId? n env with
  | some t => some t
  | none =>
    match env.find? n with
    -- Constructor/recursor of a tagged inductive inherit the inductive's tag.
    | some (.ctorInfo ci) => LCS.lcsItemId? ci.induct env
    | some (.recInfo ri) =>
      match ri.all.head? with
      | some indName => LCS.lcsItemId? indName env
      | none => none
    | _ =>
      -- Structure field projection: inherit from the parent structure via
      -- Lean's canonical `Environment.getProjectionStructureName?`. More
      -- precise than namespace-chain walking — only fires on genuine
      -- projections, not on name coincidences.
      match env.getProjectionStructureName? n with
      | some structName => LCS.lcsItemId? structName env
      | none =>
        -- Auto-derived `inst<Class><Type>` instances live alongside the type
        -- in the same namespace. Detect the pattern and inherit from the
        -- type's tag (whose source-level `deriving` clause generated them).
        match autoDerivedParent? n with
        | some parent =>
          match LCS.lcsItemId? parent env with
          | some t => some t
          | none =>
            -- Auto-generated names (`.below`, `.brecOn`, `.brecOn.go`,
            -- `.casesOn`, `.match_N`, `._f`, `._sizeOf`, etc.) inherit their
            -- parent's tag. Recurse through the namespace chain until we find
            -- a source-level tagged decl, or bottom out.
            match n with
            | .str p _ =>
              if p.isAnonymous then none
              else
                match LCS.lcsItemId? p env with
                | some t => some t
                | none =>
                  if env.contains p then effectiveTag env p else effectiveTag env p
            | _ => none
        | none =>
          match n with
          | .str p _ =>
            if p.isAnonymous then none
            else
              match LCS.lcsItemId? p env with
              | some t => some t
              | none =>
                if env.contains p then effectiveTag env p else effectiveTag env p
          | _ => none

open Lean in
/-- Walk the complete set of LCS-prefixed constants reachable from a root
declaration, following the same rules as tag_verify.py: for `def`/`abbrev`/
`instance`, walk both type and value; for `theorem`/`lemma`, walk type only;
for `inductive`, walk type and descend into constructors. -/
def runStmtDeps (env : Environment) (n : Name) : IO Unit := do
  match env.find? n with
  | none => IO.println s!"Error: `{n}` not found"
  | some _ =>
    let rootTag := LCS.lcsItemId? n env
    let rootTagStr := match rootTag with
      | some t => s!"@[blueprint \"{t}\"]"
      | none => "(no tag)"
    let mut visited : NameSet := {}
    let mut queue : List Name := [n]
    let mut result : NameSet := {}
    while !queue.isEmpty do
      match queue with
      | [] => break
      | nm :: rest =>
        queue := rest
        if visited.contains nm then continue
        visited := visited.insert nm
        match env.find? nm with
        | some info =>
          -- Always collect from the type.
          let typeDeps := collectLCSConsts info.type
          for d in typeDeps.toList do
            result := result.insert d
            if !visited.contains d then
              queue := d :: queue
          -- For def/instance/abbrev: also collect from the value (body).
          if shouldWalkBody info then
            if let some v := info.value? then
              let valDeps := collectLCSConsts v
              for d in valDeps.toList do
                result := result.insert d
                if !visited.contains d then
                  queue := d :: queue
          -- For inductive: descend into constructors.
          for c in inductiveExtras env nm do
            if !visited.contains c then
              queue := c :: queue
            result := result.insert c
        | none => continue
    let sorted := result.toList.mergeSort (·.toString < ·.toString)
    IO.println s!"Deps for `{n}` {rootTagStr}"
    IO.println s!"({sorted.length} LCS decls):"
    for depN in sorted do
      let tag := effectiveTag env depN
      let tagStr := match tag with
        | some t => s!"  @[blueprint \"{t}\"]"
        | none =>
          -- Project-infrastructure types live under `LCS.Util` / `LCS.Finset`
          -- / `LCS.Multiset` / `LCS.Tools` / `LCS.Item`. They are intentionally
          -- untagged (not textbook items). Mark them "(infra)" so audits don't
          -- flag them as missing-tag issues.
          let s := depN.toString
          if s.startsWith "LCS.Util." || s.startsWith "LCS.Finset" ||
             s.startsWith "LCS.Multiset" || s.startsWith "LCS.Tools" ||
             s.startsWith "LCS.Item" ||
             s.startsWith "LCS.TreeAddr" || s.startsWith "LCS.TreeDomain" ||
             s.startsWith "LCS.LabeledTree" then
            "  (infra)"
          else ""
      IO.println s!"  {depN}{tagStr}"

open Lean Elab Term in
/-- VS Code variant of `runStmtDeps`: same BFS closure over LCS-prefixed
constants, but runs in `TermElabM` against the ambient elaboration environment
and reports via `logInfo` so the result shows in the Lean Infoview when invoked
as `#eval stmtDeps `Name`. Tags here are reported with the direct
`LCS.lcsItemId?` (no `effectiveTag` ownership-walk / infra annotation). -/
def stmtDeps (n : Name) : TermElabM Unit := do
  let env ← getEnv
  match env.find? n with
  | none => logInfo m!"Error: `{n}` not found"
  | some _ =>
    let rootTag := LCS.lcsItemId? n env
    let rootTagStr := match rootTag with
      | some t => s!"@[blueprint \"{t}\"]"
      | none => "(no tag)"
    let mut visited : NameSet := {}
    let mut queue : List Name := [n]
    let mut result : NameSet := {}
    while !queue.isEmpty do
      match queue with
      | [] => break
      | nm :: rest =>
        queue := rest
        if visited.contains nm then continue
        visited := visited.insert nm
        match env.find? nm with
        | some info =>
          let typeDeps := collectLCSConsts info.type
          for d in typeDeps.toList do
            result := result.insert d
            if !visited.contains d then
              queue := d :: queue
          if shouldWalkBody info then
            if let some v := info.value? then
              let valDeps := collectLCSConsts v
              for d in valDeps.toList do
                result := result.insert d
                if !visited.contains d then
                  queue := d :: queue
          for c in inductiveExtras env nm do
            if !visited.contains c then
              queue := c :: queue
            result := result.insert c
        | none => continue
    let sorted := result.toList.mergeSort (·.toString < ·.toString)
    logInfo m!"Deps for `{n}` {rootTagStr}"
    logInfo m!"({sorted.length} LCS decls):"
    for depN in sorted do
      let tag := LCS.lcsItemId? depN env
      let tagStr := match tag with
        | some t => s!"@[blueprint \"{t}\"]"
        | none => ""
      logInfo m!"  {depN}  {tagStr}"

/-- Parse CLI args into a list of module names and a target declaration name.
Accepts zero or more `--module M` flags followed by a single target name. -/
def parseArgs (args : List String) : Except String (List Lean.Name × Lean.Name) :=
  let rec go : List String → List Lean.Name → Except String (List Lean.Name × Lean.Name)
    | [], _ => .error "missing target declaration name"
    | ["--module"], _ => .error "`--module` requires an argument"
    | "--module" :: m :: rest, acc => go rest (m.toName :: acc)
    | [s], acc => .ok (acc.reverse, s.toName)
    | extra, _ => .error s!"unexpected extra arguments: {extra}"
  go args []

/-- Derive a module name from a declaration name by dropping the last
component. E.g. `LCS.Foo.Bar.baz` → `LCS.Foo.Bar`. Falls back to `LCS` if the
declaration has no parent namespace. -/
def moduleOfDecl (n : Lean.Name) : Lean.Name :=
  match n with
  | .str p _ => if p.isAnonymous then `LCS else p
  | .num p _ => if p.isAnonymous then `LCS else p
  | .anonymous => `LCS

open Lean in
/-- Bulk audit (`--audit` CLI mode). Iterate over every tagged declaration in
`env`, compute each one's LCS-dependency closure (same BFS as `runStmtDeps`),
and print, per tagged main, the deps that have NO effective tag and are NOT
project infrastructure (`LCS.Util` / `LCS.Finset` / `LCS.Multiset` /
`LCS.Tools` / `LCS.Item` / `LCS.TreeAddr` / `LCS.TreeDomain` /
`LCS.LabeledTree`). Ends with a summary count. Output is `#`-prefixed and
JSON-lines-friendly for downstream scripts; the report surfaces missing-tag
coverage gaps. -/
def runAuditAll (env : Environment) : IO Unit := do
  -- Find every tagged main in the environment.
  let mainsRef ← IO.mkRef (#[] : Array (Name × String))
  env.constants.forM fun n _ => do
    match LCS.lcsItemId? n env with
    | some tag => mainsRef.modify (·.push (n, tag))
    | none => pure ()
  let mains ← mainsRef.get
  -- Sort by name for deterministic output.
  let mainsSorted := mains.qsort (fun (a, _) (b, _) => a.toString < b.toString)
  IO.println s!"# Tagged mains: {mainsSorted.size}"
  let mut totalMissing := 0
  let mut mainsWithMissing := 0
  for (rootName, rootTag) in mainsSorted do
    -- Compute closure (same traversal as runStmtDeps).
    let mut visited : NameSet := {}
    let mut queue : List Name := [rootName]
    let mut result : NameSet := {}
    while !queue.isEmpty do
      match queue with
      | [] => break
      | nm :: rest =>
        queue := rest
        if visited.contains nm then continue
        visited := visited.insert nm
        match env.find? nm with
        | some info =>
          let typeDeps := collectLCSConsts info.type
          for d in typeDeps.toList do
            result := result.insert d
            if !visited.contains d then
              queue := d :: queue
          if shouldWalkBody info then
            if let some v := info.value? then
              let valDeps := collectLCSConsts v
              for d in valDeps.toList do
                result := result.insert d
                if !visited.contains d then
                  queue := d :: queue
          for c in inductiveExtras env nm do
            if !visited.contains c then
              queue := c :: queue
            result := result.insert c
        | none => continue
    -- Collect missing (truly untagged, non-infra) deps.
    let mut missing : List Name := []
    for depN in result.toList do
      match effectiveTag env depN with
      | some _ => pure ()
      | none =>
        let s := depN.toString
        let isInfra := s.startsWith "LCS.Util." || s.startsWith "LCS.Finset" ||
                       s.startsWith "LCS.Multiset" || s.startsWith "LCS.Tools" ||
                       s.startsWith "LCS.Item" ||
                       s.startsWith "LCS.TreeAddr" || s.startsWith "LCS.TreeDomain" ||
                       s.startsWith "LCS.LabeledTree"
        if !isInfra then missing := depN :: missing
    if !missing.isEmpty then
      mainsWithMissing := mainsWithMissing + 1
      totalMissing := totalMissing + missing.length
      let missingSorted := missing.mergeSort (·.toString < ·.toString)
      IO.println s!"\n## {rootName}  @[blueprint \"{rootTag}\"]"
      IO.println s!"   missing {missing.length} dep(s):"
      for m in missingSorted do
        IO.println s!"     - {m}"
  IO.println s!"\n# Summary:"
  IO.println s!"#   mains with missing tags: {mainsWithMissing}"
  IO.println s!"#   total missing deps: {totalMissing}"

open Lean in
/-- CLI entry point (for `lake env lean --run`).

Usage:
  * `lake env lean --run LCS/Tools/DeclDeps.lean [--module M]* <decl.name>`
    — print the dependency closure of `<decl.name>` (see `runStmtDeps`).
  * `lake env lean --run LCS/Tools/DeclDeps.lean --audit [--module M]*`
    — bulk missing-tag audit over all tagged decls (see `runAuditAll`).

Dispatches on a leading `--audit`, otherwise parses `--module`/target via
`parseArgs`. Imports the requested module(s) at runtime (auto-derived from the
target's namespace when none given). Exits non-zero with a usage/hint message on
a parse error or a module-import failure. -/
def main (args : List String) : IO Unit := do
  -- Handle --audit mode (iterate all tagged decls).
  if args.head? = some "--audit" then
    let rest := args.tail
    -- Parse optional --module flags after --audit.
    let rec collectMods : List String → List Name
      | [] => []
      | "--module" :: m :: xs => m.toName :: collectMods xs
      | _ :: xs => collectMods xs
    let mods := collectMods rest
    let modsToImport := if mods.isEmpty then [`LCS] else mods
    let imports := modsToImport.toArray.map (fun m => { module := m : Import })
    let env ←
      try
        importModules imports {}
      catch e =>
        IO.eprintln s!"Error importing modules {modsToImport}: {e.toString}"
        IO.Process.exit 1
    runAuditAll env
    return
  match parseArgs args with
  | .error msg =>
    IO.eprintln s!"Error: {msg}"
    IO.eprintln "Usage:"
    IO.eprintln "  lake env lean --run LCS/Tools/DeclDeps.lean [--module M]* <decl.name>"
    IO.eprintln "  lake env lean --run LCS/Tools/DeclDeps.lean --audit [--module M]*"
    IO.Process.exit 1
  | .ok (mods, name) =>
    let modsToImport :=
      if mods.isEmpty then [moduleOfDecl name] else mods
    let imports := modsToImport.toArray.map (fun m => { module := m : Import })
    let env ←
      try
        importModules imports {}
      catch e =>
        IO.eprintln s!"Error importing modules {modsToImport}: {e.toString}"
        IO.eprintln "Hint: ensure each module builds (`lake build <module>`), or pass a"
        IO.eprintln "different `--module M` that transitively contains the target decl."
        IO.Process.exit 1
    runStmtDeps env name

